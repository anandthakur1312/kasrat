# Frontend env vars. Copy to .env and fill in.

# Backend API base URL.
# - Local dev: leave default (http://localhost:3001)
# - Deploy: set to https://api.kasrat.in (or your backend's URL)
VITE_API_URL=http://localhost:3001

# Toggle to switch between the in-memory mockApi and the real Fastify backend.
# 1 = use realApi (requires backend running and Clerk keys); empty = use mockApi.
VITE_USE_REAL_API=1

# Clerk publishable key — get from https://dashboard.clerk.com → API Keys.
# Starts with pk_test_ in dev, pk_live_ in production. Safe to commit/share
# (it's a public key) but we keep it out of git anyway.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
