{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": false,
    "paths": {
      "@gym-app/shared": ["../shared/src/types.ts"],
      "@gym-app/shared/types": ["../shared/src/types.ts"]
    }
  },
  "include": ["src/**/*"]
}
