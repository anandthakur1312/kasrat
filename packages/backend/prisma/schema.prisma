// Prisma schema for Kasrat.
// Postgres everywhere. Local dev points at a Neon `dev` branch via
// packages/backend/.env; production points at the Neon `main` branch via the
// SST DatabaseUrl secret. binaryTargets includes both the host platform's
// native engine (laptop dev) and rhel-openssl-3.0.x (AWS Lambda runtime).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           String      @id
  clerkUserId  String      @unique
  email        String      @unique
  name         String
  phone        String?
  createdAt    DateTime    @default(now())
  gyms         Gym[]
  gymUsers     GymUser[]
}

model Gym {
  id              String       @id
  ownerId         String
  name            String
  slug            String       @unique
  address         String
  timings         String
  contactPhone    String
  upiId           String
  upiDisplayName  String
  gracePeriodDays Int          @default(3)
  createdAt       DateTime     @default(now())
  owner           Owner        @relation(fields: [ownerId], references: [id])
  plans           Plan[]
  members         Member[]
  gymUsers        GymUser[]
  invites         GymInvite[]
}

// Issue #16: shared gym access. A user can access a gym only if they have an
// active GymUser row for that gym. Roles are 'admin' (full management) and
// 'staff' (member/payment ops only). status is 'active' or 'disabled' —
// disabled rows are kept for audit so payment.recordedBy still resolves.
model GymUser {
  id        String    @id
  gymId     String
  ownerId   String
  role      String    // 'admin' | 'staff'
  status    String    @default("active") // 'active' | 'disabled'
  createdAt DateTime  @default(now())
  joinedAt  DateTime  @default(now())

  gym   Gym   @relation(fields: [gymId], references: [id])
  owner Owner @relation(fields: [ownerId], references: [id])

  @@unique([gymId, ownerId])
  @@index([ownerId])
  @@index([gymId])
}

// Invite issued by a gym admin. tokenHash holds a SHA-256 of the raw token;
// the raw token is shown to the inviter exactly once (for them to share via
// WhatsApp/SMS). Acceptance is a single conditional UPDATE on status to make
// it safe under concurrent clicks.
model GymInvite {
  id           String    @id
  gymId        String
  email        String
  role         String    // 'admin' | 'staff'
  status       String    @default("pending") // 'pending' | 'accepted' | 'revoked' | 'expired'
  tokenHash    String    @unique
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([email])
}

model Plan {
  id             String       @id
  gymId          String
  durationMonths Int
  price          Int
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  gym            Gym          @relation(fields: [gymId], references: [id])
  memberships    Membership[]
}

model Member {
  id               String       @id
  gymId            String
  name             String
  phone            String
  joinDate         String
  preferredSession String       @default("flexible")
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  gym              Gym          @relation(fields: [gymId], references: [id])
  memberships      Membership[]
}

model Membership {
  id          String    @id
  memberId    String
  planId      String
  startDate   String
  endDate     String
  amountDue   Int
  amountPaid  Int       @default(0)
  customPrice Int?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  member      Member    @relation(fields: [memberId], references: [id])
  plan        Plan      @relation(fields: [planId], references: [id])
  payments    Payment[]
}

model Payment {
  id              String     @id
  membershipId    String
  amount          Int
  method          String
  paidOn          String
  adjustmentType  String?
  referenceNote   String     @default("")
  recordedBy      String
  recordedByName  String
  createdAt       DateTime   @default(now())
  membership      Membership @relation(fields: [membershipId], references: [id])
}
