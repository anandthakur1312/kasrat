# Backend env vars. Copy to .env and fill in.

# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3001

# Clerk — get these from https://dashboard.clerk.com → Your App → API Keys
# The secret key is used by the backend to verify JWTs sent from the frontend
# and to look up new users on JIT Owner creation. NEVER commit this value.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
