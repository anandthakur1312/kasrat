# Backend env vars. Copy to .env and fill in.

# Database (Neon Postgres pooled connection string).
#
# Local dev:
#   1. Open https://console.neon.tech → your project → Branches.
#   2. Create a branch named "dev" off main (instant, free).
#   3. Click the branch → Connection details → copy the *pooled* URL
#      (the one with "-pooler" in the hostname). Paste it below.
#
# The format looks like:
#   postgresql://USER:PASS@ep-xxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Production: this value lives in SST as a secret instead of .env —
# see REPORT.md §11.3.
DATABASE_URL=postgresql://REPLACE_ME

# Server
PORT=3001

# Clerk — get these from https://dashboard.clerk.com → Your App → API Keys
# The secret key is used by the backend to verify JWTs sent from the frontend
# and to look up new users on JIT Owner creation. NEVER commit this value.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
